# kariyer-seo-service — production environment.
#
#   cp .env.example .env
#
# Every key here is read by docker-compose.yml through env_file. Options are validated with
# ValidateOnStart, so a missing or malformed value is a crash at boot rather than a service that
# looks healthy and is quietly wrong. That is deliberate: this service has NO user-facing failure
# mode — a misconfigured sitemap writer reports perfect health for weeks while the live sitemap
# ages, and nobody finds out until traffic drops.
#
# SERVICE_ROLE is NOT set here. docker-compose.yml sets it per service, next to the replica count,
# because the two must not drift apart — and a value in this file would be overridden by that
# anyway. See the comments in the compose file.

# ── Database ──────────────────────────────────────────────────────────────────
# The SAME Postgres as the Node backend, the CMS service and the freshness service. This service
# reads company_job and cms.seo_page as keyless read-only projections and creates neither.
ConnectionStrings__Postgres=Host=127.0.0.1;Port=5432;Database=kariyer;Username=postgres;Password=

ConnectionStrings__RabbitMQ=amqp://user:pass@127.0.0.1:5672/

# ── Site ──────────────────────────────────────────────────────────────────────
# Must match Cms__SiteUrl in kariyer-cms-service EXACTLY. A wrong scheme or a stray www. does not
# fail — it publishes several hundred thousand URLs that all redirect.
Seo__SiteUrl=https://kariyerzamani.com

# MUST be false on every non-production host (tst, staging, preview).
#
# A test deployment is a complete copy of the site at a different name; left crawlable it competes
# with production for its own rankings, and publishing a sitemap for it is the most effective way
# to make that happen. Defaults TRUE so a production deploy that forgets the flag does not
# silently de-list the whole site — which means a staging deploy that forgets it is the dangerous
# direction. The boot log states which way it resolved, at WARNING, every time.
Seo__AllowIndexing=true

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
# REQUIRED for any role that writes sitemaps (builder, all). The options validator refuses to
# start such a role with an incomplete R2 block — deliberately, because a blank bucket produces a
# service that reports perfect health while the live sitemap silently ages.
Seo__R2__Endpoint=https://REPLACE.r2.cloudflarestorage.com
Seo__R2__Bucket=kariyer-seo
Seo__R2__AccessKey=
Seo__R2__SecretKey=
Seo__R2__Prefix=

# Store the sitemaps pre-gzipped. FALSE, because Cloudflare fronts this bucket.
#
# Pre-compressing in object storage is only right when object storage is the origin a client
# talks to. Behind a CDN it duplicates a job the edge does better — the edge negotiates brotli or
# gzip per client from one stored object — and it creates an encoding hazard the edge cannot see
# through. With it on, production served bodies needing TWO gunzip passes to clients sending
# `Accept-Encoding: gzip`, and raw gzip bytes labelled `Content-Type: application/xml` with no
# `Content-Encoding` at all to clients sending none.
#
# COUPLED TO THE CLOUDFLARE ROUTE. Turning it on renames the stored keys to `.xml.gz` AND makes
# the sitemap index name its children with that suffix, so the `/sitemap-*.xml` rule has to be
# repointed in the same change or the index becomes a list of 404s that nothing here reports.
# Set it true only for a deployment serving straight from the bucket. See DEPLOYMENT.md §4.
Seo__R2__Compress=false

# ── Garnet (prerender cache) ──────────────────────────────────────────────────
# Enabled means USABLE: true with an empty ConnectionString FAILS STARTUP on a role that purges.
# A purge that never happens is invisible — the job leaves the sitemap on schedule while the
# prerenderer keeps serving its rendered 'apply now' page until the TTL expires.
Garnet__Enabled=true
Garnet__ConnectionString=127.0.0.1:6379

# ── Google Indexing API (optional) ────────────────────────────────────────────
# Off by default and honestly so: quota-limited to 200 URLs/day, JobPosting only, and needs a
# service account added as an owner of the Search Console property. Enabled means USABLE — true
# without a readable CredentialsPath fails startup.
Indexing__Enabled=false
Indexing__CredentialsPath=

# ── Observability ─────────────────────────────────────────────────────────────
# The BASE collector URL, with no /v1 path — the exporter appends /v1/traces, /v1/metrics and
# /v1/logs itself. HTTP/protobuf on 4318, NOT gRPC on 4317: an exporter that cannot reach its
# collector drops batches in the background and reports nothing, so the only symptom of getting
# this wrong is absence, which looks exactly like a quiet service.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
DEPLOYMENT_ENVIRONMENT=production

# SigNoz Cloud only. Format: key=value,key2=value2
# OTEL_EXPORTER_OTLP_HEADERS=signoz-access-token=REPLACE

# Widens what ships to the collector during an incident, without a redeploy. Console output is
# unaffected. Verbose | Debug | Information | Warning | Error | Fatal
# OTEL_LOGS_MINIMUM_LEVEL=Debug

# ── Build ─────────────────────────────────────────────────────────────────────
# Kariyer.Messaging.Contracts lives on GitHub Packages; restore needs read:packages.
GITHUB_USER=
GITHUB_TOKEN=
